    {
      "id": "9GPHIPEQB-fukYzjokqeU",
      "type": "text",
      "x": 5080.4787636292385,
      "y": -1600.8765294503146,
      "width": 499.099609375,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
